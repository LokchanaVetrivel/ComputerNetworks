import java.util.*;

class Solution {
    public int numBusesToDestination(int[][] routes, int source, int target) {
        if (source == target) return 0;
        
        // Map from stop number to a list of buses that pass through that stop
        Map<Integer, List<Integer>> stopToBuses = new HashMap<>();
        for (int bus = 0; bus < routes.length; bus++) {
            for (int stop : routes[bus]) {
                stopToBuses.putIfAbsent(stop, new ArrayList<>());
                stopToBuses.get(stop).add(bus);
            }
        }
        
        // If source or target stop doesn't exist in any route
        if (!stopToBuses.containsKey(source) || !stopToBuses.containsKey(target)) {
            return -1;
        }
        
        // BFS queue to store the buses we take
        Queue<Integer> queue = new LinkedList<>();
        boolean[] visitedBuses = new boolean[routes.length];
        
        // Start by boarding all buses that pass through the source stop
        for (int bus : stopToBuses.get(source)) {
            queue.add(bus);
            visitedBuses[bus] = true;
        }
        
        int busCount = 1;
        
        while (!queue.isEmpty()) {
            int size = queue.size();
            for (int i = 0; i < size; i++) {
                int currentBus = queue.poll();
                
                // Check if this bus reaches the target stop
                for (int stop : routes[currentBus]) {
                    if (stop == target) {
                        return busCount;
                    }
                }
                
                // Find all other buses we can transfer to from the current bus
                for (int stop : routes[currentBus]) {
                    for (int nextBus : stopToBuses.get(stop)) {
                        if (!visitedBuses[nextBus]) {
                            visitedBuses[nextBus] = true;
                            queue.add(nextBus);
                        }
                    }
                }
            }
            busCount++;
        }
        
        return -1;
    }
}
